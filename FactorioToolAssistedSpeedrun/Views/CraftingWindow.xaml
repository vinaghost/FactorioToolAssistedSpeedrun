<Window
    x:Class="FactorioToolAssistedSpeedrun.Views.CraftingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attachedBehaviours="clr-namespace:FactorioToolAssistedSpeedrun.Misc.AttachedBehaviours"
    xmlns:conventers="clr-namespace:FactorioToolAssistedSpeedrun.Misc.Conventers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:FactorioToolAssistedSpeedrun.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:misc="clr-namespace:FactorioToolAssistedSpeedrun.Misc"
    xmlns:vm="clr-namespace:FactorioToolAssistedSpeedrun.ViewModels"
    Title="Crafting"
    Width="800"
    Height="450"
    d:DataContext="{d:DesignInstance vm:CraftingViewModel,
                                     IsDesignTimeCreatable=True}"
    mc:Ignorable="d">
    <Window.Resources>
        <conventers:StepTypeToStringConverter x:Key="StepTypeToStringConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button
            Grid.Column="1"
            Margin="2"
            Command="{Binding RefreshCommand}"
            Content="Refresh" />
        <DataGrid
            x:Name="Steps"
            Grid.Row="1"
            Grid.ColumnSpan="7"
            Margin="0,5,0,0"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="False"
            CanUserResizeRows="False"
            CanUserSortColumns="False"
            EnableRowVirtualization="True"
            ItemsSource="{Binding PanelService.CraftingCollection, Mode=OneWay}"
            ScrollViewer.IsDeferredScrollingEnabled="True"
            SelectedItem="{Binding PanelService.SelectedCraftStep}"
            SelectionMode="Extended"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Resources>
                <misc:BindingProxy x:Key="proxy" Data="{Binding StartupService.ItemsCollection, Mode=OneWay}" />
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Location, Mode=OneWay}"
                    Header="" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Type, Mode=OneWay, Converter={StaticResource StepTypeToStringConverter}}"
                    Header="Step" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Amount}"
                    Header="Amount" />
                <DataGridTextColumn
                    Width="2*"
                    Binding="{Binding Item}"
                    Header="Item">
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="{x:Type TextBox}">
                            <Setter Property="attachedBehaviours:AutoCompleteBehavior.AutoCompleteItemsSource" Value="{Binding Data, Source={StaticResource proxy}}" />
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Comment}"
                    Header="Comment" />
                <DataGridCheckBoxColumn
                    Width="Auto"
                    Binding="{Binding IsSkip}"
                    Header="Skip" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>