<Window
    x:Class="FactorioToolAssistedSpeedrun.Views.ImportStringWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:FactorioToolAssistedSpeedrun.AttachedBehaviours"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:FactorioToolAssistedSpeedrun.ViewModels"
    Title="ImportString"
    Width="800"
    Height="450"
    d:DataContext="{d:DesignInstance vm:ImportStringViewModel,
                                     IsDesignTimeCreatable=True}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Margin="2"
            Orientation="Horizontal">
            <Button
                Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
                Command="{Binding CurrentStepIndexCommand}"
                Content="C" />
            <TextBox MinWidth="60" Text="{Binding LineIndex}" />
        </StackPanel>
        <Button
            Grid.Row="1"
            Grid.Column="0"
            Margin="2"
            Content="Into steps">
            <Button.InputBindings>
                <MouseBinding
                    Command="{Binding IntoStepCommand}"
                    CommandParameter="{StaticResource False}"
                    Gesture="LeftClick" />
                <MouseBinding
                    Command="{Binding IntoStepCommand}"
                    CommandParameter="{StaticResource True}"
                    Gesture="RightClick" />
            </Button.InputBindings>
        </Button>

        <TextBox
            Grid.Row="0"
            Grid.Column="1"
            Margin="2"
            Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}" />
        <Button
            Grid.Row="1"
            Grid.Column="1"
            Margin="2"
            Command="{Binding IntoTemplateCommand}"
            Content="Into template" />

        <CheckBox
            Grid.Row="0"
            Grid.Column="2"
            Margin="2"
            VerticalAlignment="Center"
            Content="Clear after import"
            IsChecked="{Binding ClearAfterImport}" />

        <TextBox
            Grid.Row="2"
            Grid.ColumnSpan="4"
            Margin="5"
            AcceptsReturn="True"
            Text="{Binding ImportString, UpdateSourceTrigger=PropertyChanged}"
            VerticalScrollBarVisibility="Auto" />
    </Grid>
</Window>