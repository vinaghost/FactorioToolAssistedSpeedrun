<Window
    x:Class="FactorioToolAssistedSpeedrun.Views.ReplaceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:FactorioToolAssistedSpeedrun.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:FactorioToolAssistedSpeedrun.ViewModels"
    Icon="pack://application:,,,/favicon.ico"
    Title="Replace"
    d:DataContext="{d:DesignInstance vm:ReplaceViewModel,
                                     IsDesignTimeCreatable=True}"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="150" />
        </Grid.ColumnDefinitions>

        <!--  Find X  -->
        <Label
            Grid.Row="0"
            Grid.Column="0"
            VerticalAlignment="Center"
            Content="Find X:" />
        <TextBox
            Name="FindXTextBox"
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,5,0,5"
            Text="{Binding FindX, UpdateSourceTrigger=PropertyChanged}" />

        <!--  Find Y  -->
        <Label
            Grid.Row="1"
            Grid.Column="0"
            VerticalAlignment="Center"
            Content="Find Y:" />
        <TextBox
            Name="FindYTextBox"
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,5,0,5"
            Text="{Binding FindY, UpdateSourceTrigger=PropertyChanged}" />

        <!--  Replace X  -->
        <Label
            Grid.Row="0"
            Grid.Column="3"
            VerticalAlignment="Center"
            Content="Replace X:" />
        <TextBox
            Name="ReplaceXTextBox"
            Grid.Row="0"
            Grid.Column="4"
            Margin="0,5,0,5"
            Text="{Binding ReplaceX, UpdateSourceTrigger=PropertyChanged}" />

        <!--  Replace Y  -->
        <Label
            Grid.Row="1"
            Grid.Column="3"
            VerticalAlignment="Center"
            Content="Replace Y:" />
        <TextBox
            Name="ReplaceYTextBox"
            Grid.Row="1"
            Grid.Column="4"
            Margin="0,5,0,5"
            Text="{Binding ReplaceY, UpdateSourceTrigger=PropertyChanged}" />

        <!--  Find Button  -->
        <Button
            Grid.Row="2"
            Grid.Column="1"
            Width="80"
            Margin="0,10,0,0"
            Command="{Binding FindCommand}"
            Content="Find" />

        <!--  Replace Button  -->
        <Button
            Grid.Row="2"
            Grid.Column="4"
            Width="80"
            Margin="0,10,0,0"
            Command="{Binding ReplaceCommand}"
            Content="Replace" />

        <!--  Instances Found Label  -->
        <Label
            Name="InstancesFoundLabel"
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="5"
            Margin="0,15,0,0"
            Content="{Binding InstancesFound, StringFormat=Instances found: {0}}" />
    </Grid>
</Window>