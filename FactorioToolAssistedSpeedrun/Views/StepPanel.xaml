<UserControl
    x:Class="FactorioToolAssistedSpeedrun.Views.StepPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attachedBehaviours="clr-namespace:FactorioToolAssistedSpeedrun.AttachedBehaviours"
    xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:conventers="clr-namespace:FactorioToolAssistedSpeedrun.Conventers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:FactorioToolAssistedSpeedrun.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:misc="clr-namespace:FactorioToolAssistedSpeedrun.Misc"
    xmlns:vm="clr-namespace:FactorioToolAssistedSpeedrun.ViewModels"
    d:DataContext="{d:DesignInstance vm:StepPanelViewModel,
                                     IsDesignTimeCreatable=True}"
    Loaded="LoadHandler"
    mc:Ignorable="d">
    <UserControl.Resources>
        <conventers:StepTypeToStringConverter x:Key="StepTypeToStringConverter" />
        <conventers:ItemNameToStringConverter x:Key="ItemNameToStringConverter" />
        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="attachedBehaviours:MouseRightButtonUpBehavior.MouseRightButtonUpCommand" Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.MouseRightButtonUpCommand}" />
        </Style>
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="attachedBehaviours:DeleteRowBehavior.DeleteRowCommand" Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.DeleteCommand}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button
            Grid.Column="0"
            Margin="2"
            Content="Add">
            <Button.InputBindings>
                <MouseBinding
                    Command="{Binding AddCommand}"
                    CommandParameter="{StaticResource False}"
                    Gesture="LeftClick" />
                <MouseBinding
                    Command="{Binding AddCommand}"
                    CommandParameter="{StaticResource True}"
                    Gesture="RightClick" />
            </Button.InputBindings>
        </Button>
        <Button
            Grid.Column="1"
            Margin="2"
            Command="{Binding DeleteCommand}"
            CommandParameter="{Binding ElementName=Steps, Path=SelectedItems}"
            Content="Delete" />
        <Button
            Grid.Column="2"
            Margin="2"
            Content="Move Up">
            <Button.InputBindings>
                <MouseBinding
                    Command="{Binding MoveUpOneCommand}"
                    CommandParameter="{Binding ElementName=Steps, Path=SelectedItems}"
                    Gesture="LeftClick" />
                <MouseBinding
                    Command="{Binding MoveUpFiveCommand}"
                    CommandParameter="{Binding ElementName=Steps, Path=SelectedItems}"
                    Gesture="RightClick" />
            </Button.InputBindings>
        </Button>
        <Button
            Grid.Column="3"
            Margin="2"
            Content="Move Down">
            <Button.InputBindings>
                <MouseBinding
                    Command="{Binding MoveDownOneCommand}"
                    CommandParameter="{Binding ElementName=Steps, Path=SelectedItems}"
                    Gesture="LeftClick" />
                <MouseBinding
                    Command="{Binding MoveDownFiveCommand}"
                    CommandParameter="{Binding ElementName=Steps, Path=SelectedItems}"
                    Gesture="RightClick" />
            </Button.InputBindings>
        </Button>
        <Button
            Grid.Column="5"
            Margin="2"
            Content="Skip" />
        <DataGrid
            x:Name="Steps"
            Grid.Row="1"
            Grid.ColumnSpan="7"
            Margin="0,5,0,0"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="False"
            CanUserResizeRows="False"
            CanUserSortColumns="False"
            EnableRowVirtualization="True"
            ItemsSource="{Binding StepCollection, Mode=OneWay}"
            ScrollViewer.IsDeferredScrollingEnabled="True"
            SelectedIndex="{Binding SelectedIndex}"
            SelectedItem="{Binding SelectedItem}"
            SelectionMode="Extended"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Resources>
                <misc:BindingProxy x:Key="proxy" Data="{Binding ItemCollection}" />
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Location, Mode=OneWay}"
                    Header="" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Type, Mode=OneWay, Converter={StaticResource StepTypeToStringConverter}}"
                    Header="Step" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding X}"
                    Header="X" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Y}"
                    Header="Y" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Amount}"
                    Header="Amount" />
                <DataGridTextColumn
                    Width="2*"
                    Binding="{Binding Item}"
                    Header="Item">
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="{x:Type TextBox}">
                            <Setter Property="attachedBehaviours:AutoCompleteBehavior.AutoCompleteItemsSource" Value="{Binding Data, Source={StaticResource proxy}}" />
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Orientation}"
                    Header="Orientation" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Modifier}"
                    Header="Modifier" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Comment}"
                    Header="Comment" />
                <DataGridCheckBoxColumn
                    Width="Auto"
                    Binding="{Binding IsSkip}"
                    Header="Skip" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>