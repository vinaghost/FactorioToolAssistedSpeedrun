<UserControl
    x:Class="FactorioToolAssistedSpeedrun.Views.TemplatePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attachedBehaviours="clr-namespace:FactorioToolAssistedSpeedrun.Misc.AttachedBehaviours"
    xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:conventers="clr-namespace:FactorioToolAssistedSpeedrun.Misc.Conventers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:FactorioToolAssistedSpeedrun.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:misc="clr-namespace:FactorioToolAssistedSpeedrun.Misc"
    xmlns:vm="clr-namespace:FactorioToolAssistedSpeedrun.ViewModels"
    d:DataContext="{d:DesignInstance vm:TemplatePanelViewModel,
                                     IsDesignTimeCreatable=True}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <conventers:StepTypeToStringConverter x:Key="StepTypeToStringConverter" />
        <conventers:StepToColorConverter x:Key="StepToColorConverter" />
        <conventers:ItemNameToStringConverter x:Key="ItemNameToStringConverter" />
        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="attachedBehaviours:MouseRightButtonUpBehavior.MouseRightButtonUpCommand" Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.MouseRightButtonUpCommand}" />
        </Style>
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="attachedBehaviours:DeleteRowBehavior.DeleteRowCommand" Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.RemoveCommand}" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ComboBox
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="2"
            IsEditable="True"
            ItemsSource="{Binding PanelService.TemplateCollection, Mode=OneWay}"
            SelectedValue="{Binding PanelService.SelectedTemplate}"
            Text="{Binding InputTemplate, UpdateSourceTrigger=PropertyChanged}" />
        <Button
            Grid.Row="1"
            Grid.Column="0"
            Margin="2"
            Content="Add">
            <Button.InputBindings>
                <MouseBinding
                    Command="{Binding AddCommand}"
                    CommandParameter="{StaticResource False}"
                    Gesture="LeftClick" />
                <MouseBinding
                    Command="{Binding AddCommand}"
                    CommandParameter="{StaticResource True}"
                    Gesture="RightClick" />
            </Button.InputBindings>
        </Button>
        <Button
            Grid.Row="1"
            Grid.Column="1"
            Margin="2"
            Command="{Binding RemoveCommand}"
            CommandParameter="{Binding ElementName=Steps, Path=SelectedItems}"
            Content="Remove" />

        <Button
            Grid.Row="0"
            Grid.Column="2"
            Margin="2"
            Command="{Binding NewCommand}"
            Content="New" />
        <Button
            Grid.Row="0"
            Grid.Column="3"
            Margin="2"
            Command="{Binding DeleteCommand}"
            Content="Delete" />

        <Button
            Grid.Row="1"
            Grid.Column="2"
            Margin="2"
            Content="Up">
            <Button.InputBindings>
                <MouseBinding
                    Command="{Binding MoveUpOneCommand}"
                    CommandParameter="{Binding ElementName=Steps, Path=SelectedItems}"
                    Gesture="LeftClick" />
                <MouseBinding
                    Command="{Binding MoveUpFiveCommand}"
                    CommandParameter="{Binding ElementName=Steps, Path=SelectedItems}"
                    Gesture="RightClick" />
            </Button.InputBindings>
        </Button>
        <Button
            Grid.Row="1"
            Grid.Column="3"
            Margin="2"
            Content="Down">
            <Button.InputBindings>
                <MouseBinding
                    Command="{Binding MoveDownOneCommand}"
                    CommandParameter="{Binding ElementName=Steps, Path=SelectedItems}"
                    Gesture="LeftClick" />
                <MouseBinding
                    Command="{Binding MoveDownFiveCommand}"
                    CommandParameter="{Binding ElementName=Steps, Path=SelectedItems}"
                    Gesture="RightClick" />
            </Button.InputBindings>
        </Button>
        <TextBlock
            Grid.Row="0"
            Grid.Column="5"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Text="Offset:" />
        <TextBox
            Grid.Row="0"
            Grid.Column="6"
            Margin="2"
            HorizontalContentAlignment="Right"
            Text="{Binding PanelService.Offset}" />

        <TextBlock
            Grid.Row="1"
            Grid.Column="5"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Text="Multiplier:" />
        <TextBox
            Grid.Row="1"
            Grid.Column="6"
            Margin="2"
            HorizontalContentAlignment="Right"
            Text="{Binding PanelService.Multipler}" />
        <TextBlock
            Grid.Row="0"
            Grid.Column="7"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Text="X:" />
        <TextBox
            Grid.Row="0"
            Grid.Column="8"
            Margin="2"
            HorizontalContentAlignment="Right"
            Text="{Binding PanelService.X}" />
        <TextBlock
            Grid.Row="1"
            Grid.Column="7"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Text="Y:" />
        <TextBox
            Grid.Row="1"
            Grid.Column="8"
            Margin="2"
            HorizontalContentAlignment="Right"
            Text="{Binding PanelService.Y}" />

        <TextBox
            Grid.Row="0"
            Grid.Column="9"
            Margin="2"
            HorizontalContentAlignment="Right"
            Text="{Binding PanelService.Iterator}" />
        <ComboBox
            Grid.Row="1"
            Grid.Column="9"
            Margin="2"
            ItemsSource="{Binding PanelService.TemplateDirections, Mode=OneWay}"
            SelectedItem="{Binding PanelService.TemplateDirection}" />

        <!--  DataGrid/Table area  -->
        <DataGrid
            x:Name="Steps"
            Grid.Row="2"
            Grid.ColumnSpan="12"
            Margin="0,5,0,0"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="False"
            CanUserResizeRows="False"
            CanUserSortColumns="False"
            ItemsSource="{Binding PanelService.TemplateStepCollection, Mode=OneWay}"
            SelectedIndex="{Binding PanelService.SelectedTemplateStepIndex}"
            SelectedItem="{Binding PanelService.SelectedTemplateStep}"
            SelectionMode="Extended">
            <DataGrid.Resources>
                <misc:BindingProxy x:Key="proxy" Data="{Binding StartupService.ItemsCollection, Mode=OneWay}" />
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Type, Mode=OneWay, Converter={StaticResource StepTypeToStringConverter}}"
                    Header="Step">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="{x:Type DataGridCell}">
                            <Setter Property="Background" Value="{Binding ., Converter={StaticResource StepToColorConverter}}" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding X}"
                    Header="X" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Y}"
                    Header="Y" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Amount}"
                    Header="Amount" />
                <DataGridTextColumn
                    Width="2*"
                    Binding="{Binding Item}"
                    Header="Item">
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="{x:Type TextBox}">
                            <Setter Property="attachedBehaviours:AutoCompleteBehavior.AutoCompleteItemsSource" Value="{Binding Data, Source={StaticResource proxy}}" />
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Orientation}"
                    Header="Orientation" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Modifier}"
                    Header="Modifier" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Comment}"
                    Header="Comment" />
                <DataGridCheckBoxColumn
                    Width="Auto"
                    Binding="{Binding IsSkip}"
                    Header="Skip" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>